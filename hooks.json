{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/codex_harness_hook.py",
            "statusMessage": "Harness4Codex session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/codex_harness_hook.py",
            "statusMessage": "Harness4Codex classify"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/codex_harness_hook.py",
            "statusMessage": "Harness4Codex guard"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/codex_harness_hook.py",
            "statusMessage": "Harness4Codex permission"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/codex_harness_hook.py",
            "statusMessage": "Harness4Codex state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/codex_harness_hook.py",
            "statusMessage": "Harness4Codex verify"
          }
        ]
      }
    ]
  }
}
