{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/codex_harness_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_harness_hook.py\"",
            "timeout": 10,
            "statusMessage": "Harness4Codex session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/codex_harness_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_harness_hook.py\"",
            "timeout": 10,
            "statusMessage": "Harness4Codex classify"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/codex_harness_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_harness_hook.py\"",
            "timeout": 10,
            "statusMessage": "Harness4Codex guard"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/codex_harness_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_harness_hook.py\"",
            "timeout": 10,
            "statusMessage": "Harness4Codex permission"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/codex_harness_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_harness_hook.py\"",
            "timeout": 10,
            "statusMessage": "Harness4Codex state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/codex_harness_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_harness_hook.py\"",
            "timeout": 10,
            "statusMessage": "Harness4Codex verify"
          }
        ]
      }
    ]
  }
}
